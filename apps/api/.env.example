DATABASE_URL="postgresql://survivor:survivor@localhost:5432/survivor?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
PORT=3000

# Optional until the mobile Apple/Google sign-in buttons are configured;
# when unset, token audience is not checked (fine for local dev only).
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Comma-separated allowlist for CORS (matters for Expo web / any admin
# dashboard; native iOS/Android isn't subject to CORS). Unset = allow any
# origin, fine for local dev only — set this before a real deploy.
CORS_ORIGINS=""

# API-Football key (https://dashboard.api-football.com — free plan: 100
# req/day, 10/min, all competitions including UEFA Champions League).
# Fixtures still need to be created via POST /admin/fixtures with the real
# API-Football fixture id in `externalId` (see admin-fixtures.controller.ts)
# — this key only powers the live-score poller for fixtures created that way.
# Leave unset to keep using /admin/fixtures/:id/override for manual scoring.
SPORTS_DATA_API_KEY=""

# Base URL of the web app, used to build the link in password-reset emails
# (mobile/src/app/reset-password.tsx). Defaults to the local Expo web dev
# server if unset.
FRONTEND_URL="http://localhost:8081"

# Outgoing email (password reset). Checked in this order: RESEND_API_KEY
# (https://resend.com — simplest, generous free tier) first, then SMTP_HOST
# as a fallback for any other provider (SendGrid, Gmail, etc). Leave both
# unset to keep local dev working without a real mailer — emails are just
# logged to the console instead of sent.
RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Until a domain is verified in Resend, this must stay
# "onboarding@resend.dev" — Resend only allows that shared address to send,
# and only to the email you signed up with. Switch to your own domain
# (e.g. "Survivor <no-reply@yourdomain.com>") once verified.
MAIL_FROM="Survivor <onboarding@resend.dev>"
