DATABASE_URL="postgresql://survivor:survivor@localhost:5432/survivor?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
PORT=3000

# Optional until the mobile Apple/Google sign-in buttons are configured;
# when unset, token audience is not checked (fine for local dev only).
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Comma-separated allowlist for CORS (matters for Expo web / any admin
# dashboard; native iOS/Android isn't subject to CORS). Unset = allow any
# origin, fine for local dev only — set this before a real deploy.
CORS_ORIGINS=""

# API-Football key (https://dashboard.api-football.com — free plan: 100
# req/day, 10/min, all competitions including UEFA Champions League).
# Fixtures still need to be created via POST /admin/fixtures with the real
# API-Football fixture id in `externalId` (see admin-fixtures.controller.ts)
# — this key only powers the live-score poller for fixtures created that way.
# Leave unset to keep using /admin/fixtures/:id/override for manual scoring.
SPORTS_DATA_API_KEY=""

# Base URL of the web app, used to build the link in password-reset emails
# (mobile/src/app/reset-password.tsx). Defaults to the local Expo web dev
# server if unset.
FRONTEND_URL="http://localhost:8081"

# Outgoing email (password reset). Checked in this order: SENDGRID_API_KEY,
# then RESEND_API_KEY, then SMTP_HOST as a generic fallback (Gmail, etc).
# Leave all unset to keep local dev working without a real mailer — emails
# are just logged to the console instead of sent.
#
# NOTE: plain SMTP (SMTP_HOST) may be blocked outbound on some hosts (e.g.
# Render silently drops outbound connections to Gmail's SMTP port) — prefer
# an HTTPS-API provider (SendGrid or Resend) when deploying somewhere that
# might block SMTP.
#
# SendGrid (https://sendgrid.com) — free tier, and its "Single Sender
# Verification" only requires verifying one email address you already own
# (no domain/DNS needed) before you can send to any recipient.
SENDGRID_API_KEY=""

# Resend (https://resend.com) — generous free tier, but until you verify a
# whole domain, it only allows sending from the shared "onboarding@resend.dev"
# address, and only to the email you signed up with. Fine for testing the
# integration itself; not usable for real users without a verified domain.
RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# The "from" address. With SendGrid, this must be the exact address you
# completed Single Sender Verification for. With Resend and no verified
# domain, this must stay "onboarding@resend.dev".
MAIL_FROM="Survivor <no-reply@yourdomain.com>"
