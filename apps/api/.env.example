DATABASE_URL="postgresql://survivor:survivor@localhost:5432/survivor?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
PORT=3000

# Optional until the mobile Apple/Google sign-in buttons are configured;
# when unset, token audience is not checked (fine for local dev only).
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Comma-separated allowlist for CORS (matters for Expo web / any admin
# dashboard; native iOS/Android isn't subject to CORS). Unset = allow any
# origin, fine for local dev only — set this before a real deploy.
CORS_ORIGINS=""
