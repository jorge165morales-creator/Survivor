datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Identity ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  appleSub     String?  @unique
  googleSub    String?  @unique
  // User-chosen for password sign-up; auto-generated from name/email for
  // Apple/Google sign-in, which don't collect one.
  username     String   @unique
  displayName  String
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leagueMemberships   LeagueMembership[]
  picks               Pick[]
  ownedLeagues        League[]             @relation("LeagueCommissioner")
  entitlement         UserEntitlement?
  pushTokens          PushToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // sha256 hash of the raw token mailed to the user — only the hash is
  // stored, same reasoning as passwordHash, so a DB read alone can't be used
  // to reset someone's password.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserEntitlement {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  revenueCatUserId String    @unique
  activeProductId  String?
  extraLeagueSlots Int       @default(0)
  isPro            Boolean   @default(false)
  expiresAt        DateTime?
  updatedAt        DateTime  @updatedAt
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Competition data (shared across all leagues) ----------

model Season {
  id        String     @id @default(uuid())
  name      String
  year      Int
  isActive  Boolean    @default(true)
  // A "replay" season seeded by practice-season.service.ts from a real,
  // already-completed CL season on a compressed schedule (see that file) —
  // excluded from ingestion-scheduler.service.ts's live-poll window since its
  // fixtures resolve via practice-replay-scheduler.service.ts instead.
  isPractice Boolean   @default(false)
  matchdays Matchday[]
  teams     Team[]     @relation("SeasonTeams")
  leagues   League[]

  @@index([isActive])
}

enum MatchdayType {
  GROUP
  KNOCKOUT_HOME
  KNOCKOUT_AWAY
  FINAL
}

model Matchday {
  id         String       @id @default(uuid())
  seasonId   String
  season     Season       @relation(fields: [seasonId], references: [id])
  sequence   Int
  type       MatchdayType
  roundLabel String
  lockAt     DateTime
  // Set once the "picks lock in 1 hour" push has actually been sent for
  // this matchday — see pick-reminder-scheduler.service.ts. Per-matchday
  // rather than per-user: the notification is deliberately generic ("picks
  // lock soon") regardless of who has/hasn't picked yet, so one flag here
  // is enough to stop the cron from re-sending it every tick within the
  // hour-before window.
  reminderSentAt DateTime?
  fixtures   Fixture[]
  picks      Pick[]
  eliminationsHere LeagueMembership[] @relation("EliminatedAtMatchday")

  @@unique([seasonId, sequence])
  @@index([seasonId, lockAt])
}

model Team {
  id         String   @id @default(uuid())
  name       String
  shortName  String
  crestUrl   String?
  externalId String   @unique
  seasons    Season[] @relation("SeasonTeams")

  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
  picks        Pick[]
  usedTeams    UsedTeam[]
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum FixtureResult {
  HOME_WIN
  AWAY_WIN
  DRAW
}

model Fixture {
  id                 String         @id @default(uuid())
  matchdayId         String
  matchday           Matchday       @relation(fields: [matchdayId], references: [id])
  externalId         String         @unique
  homeTeamId         String
  homeTeam           Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId         String
  awayTeam           Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffAt          DateTime
  venue              String?
  status             FixtureStatus  @default(SCHEDULED)
  homeScore          Int?
  awayScore          Int?
  result             FixtureResult?
  lastSyncedAt       DateTime?
  correctedByAdminId String?
  correctedAt        DateTime?

  picks        Pick[]
  replayResult ReplayFixtureResult?

  @@index([matchdayId])
  @@index([status])
}

// The real, already-known result for a practice/replay fixture (see
// Season.isPractice), held back until revealAt so the fixture behaves like a
// genuinely live match — SCHEDULED with no score until kickoff, then flipped
// to FINISHED with this score by practice-replay-scheduler.service.ts. Only
// ever created for practice-season fixtures, never for real ones.
model ReplayFixtureResult {
  id        String   @id @default(uuid())
  fixtureId String   @unique
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  homeScore Int
  awayScore Int
  revealAt  DateTime
  createdAt DateTime @default(now())

  @@index([revealAt])
}

// ---------- Leagues (pools) ----------

model League {
  id             String    @id @default(uuid())
  name           String
  commissionerId String
  commissioner   User      @relation("LeagueCommissioner", fields: [commissionerId], references: [id])
  seasonId       String
  season         Season    @relation(fields: [seasonId], references: [id])
  inviteCode     String    @unique @default(cuid())
  maxMembers     Int       @default(20)
  // Whether the commissioner allows an eliminated member to be granted a
  // one-time rejoin this season (see LeagueMembership.buyBackAvailable/Used).
  // Any payment for this happens outside the app, between the commissioner
  // and the member — the app only tracks whether it's been granted.
  buyBackEnabled Boolean   @default(false)
  // When true, a member who joins doesn't actually participate (isn't
  // subject to elimination, doesn't appear in standings) until the
  // commissioner marks them LeagueMembership.hasPaid — see recompute.service.ts
  // for how an unpaid member's early matchdays are skipped rather than
  // counted as missed picks once they are eventually marked paid.
  paymentRequired Boolean   @default(false)
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  memberships LeagueMembership[]
  picks       Pick[]
  usedTeams   UsedTeam[]

  @@index([inviteCode])
}

enum MembershipStatus {
  ACTIVE
  ELIMINATED
  LEFT
}

model LeagueMembership {
  id                     String            @id @default(uuid())
  leagueId               String
  league                 League            @relation(fields: [leagueId], references: [id])
  userId                 String
  user                   User              @relation(fields: [userId], references: [id])
  status                 MembershipStatus  @default(ACTIVE)
  eliminatedAtMatchdayId String?
  eliminatedAtMatchday   Matchday?         @relation("EliminatedAtMatchday", fields: [eliminatedAtMatchdayId], references: [id])
  // Set true the moment the commissioner grants this member a buy-back.
  // buyBackUsed is set true once recompute has actually consumed it to
  // forgive one elimination — kept separate from buyBackAvailable because
  // recompute replays the whole season from scratch every run and must
  // durably remember a one-time grant has already been spent, independent
  // of which historical matchday triggered it.
  buyBackAvailable       Boolean           @default(false)
  buyBackUsed            Boolean           @default(false)
  // Only meaningful when League.paymentRequired is true. hasPaid gates
  // whether this member is actually subject to the game engine at all yet
  // (see recompute.service.ts); paidAt is the moment they became eligible,
  // used the same way joinedAt is for a non-payment-gated league so a member
  // marked paid mid-season isn't penalized for matchdays that locked before
  // they were allowed to participate.
  hasPaid                Boolean           @default(false)
  paidAt                 DateTime?
  joinedAt               DateTime          @default(now())

  @@unique([leagueId, userId])
  @@index([leagueId, status])
}

// Per-user, per-league burned-team ledger. The unique constraint is what makes
// team reuse impossible even under concurrent pick submissions (see
// apps/api/src/game-engine and the plan's picks.controller notes).
model UsedTeam {
  id           String   @id @default(uuid())
  leagueId     String
  league       League   @relation(fields: [leagueId], references: [id])
  userId       String
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  usedInPickId String   @unique
  usedInPick   Pick     @relation(fields: [usedInPickId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([leagueId, userId, teamId])
  @@index([leagueId, userId])
}

enum PickOutcome {
  PENDING
  WIN
  DRAW
  LOSS
}

model Pick {
  id          String      @id @default(uuid())
  leagueId    String
  league      League      @relation(fields: [leagueId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  matchdayId  String
  matchday    Matchday    @relation(fields: [matchdayId], references: [id])
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id])
  fixtureId   String?
  fixture     Fixture?    @relation(fields: [fixtureId], references: [id])
  outcome     PickOutcome @default(PENDING)
  submittedAt DateTime    @default(now())
  lockedAt    DateTime?
  usedTeam    UsedTeam?

  @@unique([leagueId, userId, matchdayId])
  @@index([leagueId, matchdayId])
  @@index([fixtureId])
}
